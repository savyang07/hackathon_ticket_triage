# Copy to .streamlit/secrets.toml (git-ignored) and fill in ONE option.
# Both the app and scripts/precompute.py read this file.

# --- Option A: Claude API ---------------------------------------------------
ANTHROPIC_API_KEY = "sk-ant-..."

# --- Option B: Amazon Bedrock -----------------------------------------------
# LLM_PROVIDER = "bedrock"
# AWS_REGION = "us-west-2"
# AWS_PROFILE = "your-profile"        # or rely on your normal AWS credentials

# --- Optional model overrides -------------------------------------------------
# TRIAGE_MODEL = "claude-sonnet-5-5"  # used by scripts/precompute.py
# LIVE_MODEL   = "claude-haiku-5-5"   # used by tab ⑤ (fastest)
# On Bedrock use e.g. "anthropic.claude-sonnet-5-5" / "anthropic.claude-haiku-5-5"
