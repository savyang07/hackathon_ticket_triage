# Copy to .streamlit/secrets.toml (git-ignored) and fill in ONE option.
# Both the app and scripts/precompute.py read this file.

# --- Option A (default): Amazon Bedrock in Keck's approved AWS account -------
# The model runs inside that account; ticket text is PHI-shielded before every call.
LLM_PROVIDER = "bedrock"
AWS_REGION = "us-west-2"
# AWS_PROFILE = "your-profile"        # or rely on your normal AWS credentials

# --- Option B: public Claude API, SYNTHETIC DEMO TICKETS ONLY ----------------
# Refused unless ALLOW_PUBLIC_API is set to exactly this value. Never use with real tickets.
# LLM_PROVIDER = "anthropic"
# ANTHROPIC_API_KEY = "sk-ant-..."
# ALLOW_PUBLIC_API = "synthetic-data-only"

# --- Optional model overrides -------------------------------------------------
# TRIAGE_MODEL = "anthropic.claude-sonnet-5-5"  # used by scripts/precompute.py
# LIVE_MODEL   = "anthropic.claude-haiku-5-5"   # used by tab ⑤ (fastest)
# With Option B use "claude-sonnet-5-5" / "claude-haiku-5-5"
